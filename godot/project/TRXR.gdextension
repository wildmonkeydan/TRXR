[configuration]

entry_symbol = "TRXR_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]

windows.debug.x86_32 = "res://bin/windows/libTRXR.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/windows/libTRXR.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/windows/libTRXR.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/windows/libTRXR.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/linux/libTRXR.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/linux/libTRXR.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/linux/libTRXR.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/linux/libTRXR.linux.template_release.arm64.so"
linux.debug.rv64 = "res://bin/linux/libTRXR.linux.template_debug.rv64.so"
linux.release.rv64 = "res://bin/linux/libTRXR.linux.template_release.rv64.so"
android.debug.x86_64 = "res://bin/android/libTRXR.android.template_debug.x86_64.so"
android.release.x86_64 = "res://bin/android/libTRXR.android.template_release.x86_64.so"
android.debug.arm64 = "res://bin/android/libTRXR.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/android/libTRXR.android.template_release.arm64.so"